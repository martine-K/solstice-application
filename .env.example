# Django
DJANGO_SECRET_KEY=change-me-to-a-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL
POSTGRES_DB=solstice_checkin
POSTGRES_USER=solstice
POSTGRES_PASSWORD=solstice
POSTGRES_HOST=db
POSTGRES_PORT=5432

# RabbitMQ
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/
# CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//

# Base URL the printer worker container uses to call back into Django
DJANGO_INTERNAL_BASE_URL=http://web:8000

# Webhook signing secret shared between Django and the printer worker.
# MUST match on both sides. Rotate for production.
PRINTER_WEBHOOK_SECRET=dev-webhook-shared-secret-change-me

# Simulated printer behaviour
PRINTER_SIMULATED_FAILURE_RATE=0.0
PRINTER_SIMULATED_MIN_DELAY_SECONDS=1
PRINTER_SIMULATED_MAX_DELAY_SECONDS=3
